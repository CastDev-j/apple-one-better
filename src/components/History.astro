---

---

<div
  id="history-section"
  class="min-h-screen bg-gray-100 text-gray-800 p-6 sm:p-12 flex flex-col items-center"
>
  <h1 id="title" class="text-4xl font-bold mb-12 text-center text-gray-900">
    Historia de Apple Computer Inc.
  </h1>

  {/* Card 1: Fundación */}
  <div
    id="card1"
    class="card bg-white p-6 sm:p-8 rounded-lg shadow-md border border-gray-200 hover:shadow-lg transition-shadow duration-300 mb-8 max-w-4xl"
  >
    <h3 class="text-2xl sm:text-3xl font-semibold mb-4 text-gray-900">
      Inicio de Apple Computer Inc.
    </h3>
    <p class="text-gray-600 leading-relaxed">
      Esta historia se remonta al año{" "}
      <span class="text-gray-900 font-medium">1976</span>, cuando el{" "}
      <span class="text-gray-900 font-medium">1 de abril</span> de ese año tres muchachos
      crearon{" "}
      <span class="text-gray-900 font-medium">Apple Computer Inc.</span>
      : <span class="text-gray-900 font-medium">Steve Jobs</span>,{" "}
      <span class="text-gray-900 font-medium">Steve Wozniak</span> y{" "}
      <span class="text-gray-900 font-medium">Ronald Wayne</span>. Wozniak, a
      quien le decían Woz, era informático y un experto en su materia.
    </p>
  </div>

  {/* Card 2: Apple I */}
  <div
    id="card2"
    class="card grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 max-w-4xl"
  >
    <div
      class="bg-white p-6 sm:p-8 rounded-lg shadow-md border border-gray-200 hover:shadow-lg transition-shadow duration-300"
    >
      <h3 class="text-2xl sm:text-3xl font-semibold mb-4 text-gray-900">
        El primer producto
      </h3>
      <p class="text-gray-600 leading-relaxed">
        El <span class="text-gray-900 font-medium">Apple I</span> salió a la venta
        en{" "}
        <span class="text-gray-900 font-medium">julio de 1976</span> con el precio
        de{" "}
        <span class="text-gray-900 font-medium">666,66 dólares</span>. Se
        fabricaron{" "}
        <span class="text-gray-900 font-medium">200 unidades</span>. A
        diferencia de otras computadoras para aficionados de esos días, el{" "}
        <span class="text-gray-900 font-medium">Apple I</span> era un{" "}
        <span class="text-gray-900 font-medium">
          tablero de circuitos completamente ensamblado
        </span>{" "}
        que contenía{" "}
        <span class="text-gray-900 font-medium">62 chips</span>.
      </p>
    </div>
    <div class="flex items-center justify-center">
      <img
        src="/images/apple-code.jpeg"
        alt="Código Apple I"
        class="rounded-lg shadow-md border border-gray-200 w-full h-auto max-h-64 object-cover"
      />
    </div>
  </div>

  {/* Card 3: Componentes */}
  <div
    id="card3"
    class="card bg-white p-6 sm:p-8 rounded-lg shadow-md border border-gray-200 hover:shadow-lg transition-shadow duration-300 mb-8 max-w-4xl"
  >
    <h3 class="text-2xl sm:text-3xl font-semibold mb-4 text-gray-900">
      Componentes adicionales necesarios
    </h3>
    <p class="text-gray-600 leading-relaxed mb-4">
      Para hacer una computadora funcional, los usuarios tenían que agregar:
    </p>
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-600 list-disc pl-5"
    >
      <li>
        <span class="text-gray-900 font-medium">Carcasa:</span>{" "}
        necesaria para proteger y alojar los componentes.
      </li>
      <li>
        <span class="text-gray-900 font-medium">Transformador:</span>{" "}
        para proporcionar una fuente de alimentación estable.
      </li>
      <li>
        <span class="text-gray-900 font-medium">
          Interruptor de encendido:
        </span>{" "}
        para controlar el flujo de energía.
      </li>
      <li>
        <span class="text-gray-900 font-medium">Teclado ASCII:</span>{" "}
        para interactuar con la computadora.
      </li>
    </ul>
    <p class="text-gray-600 mt-4">
      Más adelante se comercializó una{" "}
      <span class="text-gray-900 font-medium">tarjeta opcional</span>{" "}
      que proporcionaba una interfaz para casetes de almacenamiento.
    </p>
  </div>

  {/* Card 4: Estado actual */}
  <div
    id="card4"
    class="card grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 max-w-4xl"
  >
    <div class="flex items-center justify-center order-1 md:order-2">
      <img
        src="/images/apple-one.jpeg"
        alt="Apple I original"
        class="rounded-lg shadow-md border border-gray-200 w-full h-auto max-h-64 object-cover"
      />
    </div>
    <div
      class="bg-white p-6 sm:p-8 rounded-lg shadow-md border border-gray-200 hover:shadow-lg transition-shadow duration-300 order-2 md:order-1"
    >
      <h3 class="text-2xl sm:text-3xl font-semibold mb-4 text-gray-900">
        Estado actual del Apple I
      </h3>
      <p class="text-gray-600 leading-relaxed">
        De los{" "}
        <span class="text-gray-900 font-medium"> 200 modelos fabricados </span>
        , quedan alrededor de{" "}
        <span class="text-gray-900 font-medium">60-70 unidades</span> en todo el
        mundo. El Apple I no es solo lo primero que hizo Apple, sino el{" "}
        <span class="text-gray-900 font-medium">
          primer PC que combinó un microprocesador con conexión para teclado y
          monitor
        </span>
        .
      </p>
    </div>
  </div>

  {/* Card 5: Recursos y enlaces */}
  <div id="card5" class="card gap-6 mb-8 max-w-4xl w-full">
    <div
      class="bg-white p-6 sm:p-8 rounded-lg shadow-md border border-gray-200 hover:shadow-lg transition-shadow duration-300"
    >
      <h3 class="text-2xl sm:text-3xl font-semibold mb-4 text-gray-900">
        Recursos y enlaces
      </h3>
      <ul class="space-y-4 text-gray-600">
        <li>
          <strong class="text-gray-900">Emulador de Apple I</strong>:{" "}
          Apple1JS – Apple 1 Emulator
        </li>
        <li>
          <strong class="text-gray-900">Manual de Apple I</strong>:{" "}
          <a
            href="http://apple1.chez.com/Apple1project/Docs/pdf/AppleI_Manual.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-500 hover:underline"
          >
            Ver PDF
          </a>
        </li>
        <li>
          <strong class="text-gray-900">Diseño del Apple I</strong>:{" "}
          <a
            href="https://www.rrauction.com/auctions/lot-detail/343672105986001-apple-1-computer-with-original-box-signed-by-steve-wozniak/#mz-expanded-view-765102684652"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-500 hover:underline"
          >
            Ver subasta
          </a>
        </li>
        <li>
          <strong class="text-gray-900">Sitio adicional</strong>:{" "}
          <a
            href="https://stid.me/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-500 hover:underline"
          >
            stid.me
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/all";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline();

  tl.from("#title", {
    scrollTrigger: {
      trigger: "#title",
      scrub: 3,
      once: true,
    },
    opacity: 0,
    duration: 0.3,
    ease: "power2.out",
  });

  const cards = ["#card1", "#card2", "#card3", "#card4", "#card5"];

  cards.forEach((cardId) => {
    tl.from(cardId, {
      scrollTrigger: {
        trigger: cardId,
        start: "top 90%",
        end: "bottom 85%",
        scrub: 3,
        once: true,
      },
      opacity: 0,
      y: 20,
      duration: 0.6,
      ease: "power2.out",
    });
  });
</script>

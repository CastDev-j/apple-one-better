---
import { FaApple } from "react-icons/fa";
import { GoArrowDown } from "react-icons/go";
---

<section
  id="hero-section"
  class="min-h-screen flex flex-col items-center justify-center text-center p-4"
>
  <div
    id="hero-title"
    class="flex flex-col items-center justify-center text-center gap-2 mb-4"
  >
    <FaApple className="text-6xl" />
    <h1 class="font-semibold text-4xl">Apple One</h1>
  </div>

  <h2 class="text-lg flex max-w-56 text-neutral-500">
    Todo lo que necesitas en un solo lugar
  </h2>

  <div
    id="hero-helper"
    class="mt-[20vh] flex flex-col items-center justify-center text-center gap-4"
  >
    <GoArrowDown className="arrow-down text-4xl" />
    <p class="text-neutral-500 text-sm mt-2 max-w-36">
      Desliza hacia abajo para ver más
    </p>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/all";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline();

  tl.from("#hero-section", {
    opacity: 0,
    duration: 0.3,
    ease: "power2.out",
  })
    .from("#hero-title", {
      y: 50,
      opacity: 0,
      duration: 0.6,
    })
    .from("h2", {
      opacity: 0,
      duration: 0.6,
      ease: "power2.inOut",
    })
    .from("#hero-helper", {
      opacity: 0,
      duration: 0.3,
      ease: "power2.out",
    })
    .from(".arrow-down", {
      y: 20,
      opacity: 0.5,
      duration: 1,
      repeat: -1,
      yoyo: true,
      ease: "power2.inOut",
    });
</script>
